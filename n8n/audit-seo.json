    {
      "parameters": {
        "jsCode": "// Lundi : bilan complet, positions comprises, envoyé dans tous les cas.\n// Les autres jours : contrôles techniques seuls, et silence tant que rien\n// n'est cassé. Un message quotidien qui répète « tout va bien » finit par\n// ne plus être lu.\nconst lundi = new Date().getDay() === 1;\nreturn [{ json: { mode: lundi ? 'hebdomadaire' : 'quotidien' } }];\n"
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "📅 Quotidien ou hebdomadaire",
